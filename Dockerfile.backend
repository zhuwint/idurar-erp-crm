FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bzip2 \
        fonts-liberation \
        libfontconfig1 \
        libfreetype6 \
        libxrender1 \
        libxext6 \
        libx11-6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/package*.json ./

RUN npm install --registry=https://registry.npmmirror.com

COPY backend/ ./

ENV NODE_ENV=production
ENV PORT=8888

EXPOSE 8888

CMD ["node", "src/server.js"]
